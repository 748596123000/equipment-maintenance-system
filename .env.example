# ============================================
# 设备检修知识检索与作业系统 - 环境配置
# 适配：银河麒麟高级服务器版 V10/V11 + LoongArch架构
# ============================================

# --- 必填配置 ---
DASHSCOPE_API_KEY=your_api_key_here

# --- 运行环境 ---
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# --- API服务 ---
API_HOST=0.0.0.0
API_PORT=8000

# --- 安全配置 ---
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- 速率限制 ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60

# --- CORS与Host ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:80"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# --- 大模型配置 ---
# LLM后端类型: dashscope / openai_compatible / ollama
LLM_BACKEND=dashscope
# 大语言模型名称
LLM_MODEL=qwen-max
# OpenAI兼容API基础URL（openai_compatible/ollama后端使用）
LLM_API_BASE_URL=
# OpenAI兼容API密钥（Ollama可设为ollama）
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- 向量化配置 ---
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# --- 检索配置 ---
CHROMA_COLLECTION_NAME=equipment_knowledge
TOP_K_RESULTS=5
RETRIEVER_SCORE_THRESHOLD=0.3

# --- 文档处理 ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=["pdf","docx","xlsx","pptx","txt","md","csv","json","xml","log","jpg","jpeg","png","bmp","gif","tiff","webp"]

# --- 数据目录 ---
UPLOAD_DIR=./data/pdfs
IMAGE_DIR=./data/images
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/app.db

# ============================================
# 银河麒麟/LoongArch专用配置（可选）
# 如需在LoongArch架构上部署，取消下方注释
# ============================================
# CHROMA_DB_IMPL=duckdb+parquet
# ANNOY_ENABLED=0
# LLM_BACKEND=ollama
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
