# 项目压缩排除清单
# 这些目录/文件不需要包含在发布包中

# Python虚拟环境
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# Node.js依赖 (可通过npm install安装)
frontend/node_modules/
frontend/.npm/
frontend/dist/
frontend/build/

# 本地pip缓存
.pip_packages/

# Node.js本地安装
.node/

# 数据文件 (用户上传的文档)
data/pdfs/
data/uploads/
data/chroma_db/

# 日志和临时文件
*.log
logs/
tmp/
temp/

# IDE配置
.idea/
.vscode/
*.swp
*.swo

# 测试文件
test_*.py
*_test.py
tests/

# 系统文件
.DS_Store
Thumbs.db
*.bak
*.tmp

# Git
.git/
.gitignore

# 其他
.env.local
.env.*.local
*.initial_passwords